# Shared figure defaults for the book notebooks.
# matplotlib reads this file from the working directory when it is imported, and the
# notebook kernels run in this folder, so every chapter's figures get the same text
# sizes without per-notebook code. Values apply only where a cell sets no explicit size.
font.size:        11
axes.titlesize:   13
axes.labelsize:   12
xtick.labelsize:  11
ytick.labelsize:  11
legend.fontsize:  11
figure.titlesize: 14
